@model Character


@if (Model.InventoryItems != null && Model.InventoryItems.Any())
        {
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Quantity</th>
                        <th style="width: 80px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.InventoryItems)
                    {
                        <tr>
                            <td>
                                <input class="form-control" name="Name" value="@item.Name" form="editForm-@item.Id" />
                            </td>
                            <td>
                                <input class="form-control" name="Description" value="@item.Description" form="editForm-@item.Id" />
                            </td>
                            <td>
                                <input class="form-control" name="Quantity" type="number" value="@item.Quantity" form="editForm-@item.Id" />
                            </td>
                            <td class="d-flex gap-1">
                                <form id="editForm-@item.Id" asp-controller="InventoryItems" asp-action="Edit" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="Id" value="@item.Id" />
                                    <input type="hidden" name="CharacterID" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">💾</button>
                                </form>
                                <form asp-controller="InventoryItems" asp-action="Remove" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                                </form>
                            </td>
                        </tr>
                    }

                    <!-- Inline Add New Item Row -->
                    <tr>
                        <td colspan="4">
                            <form asp-controller="InventoryItems" asp-action="Add" method="post" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="characterId" value="@Model.Id" />
                                <input class="form-control" name="name" placeholder="New item name" />
                                <input class="form-control" name="description" placeholder="Description" />
                                <input class="form-control" name="quantity" type="number" value="1" style="width: 160px;" />
                                <button type="submit" class="btn btn-sm btn-success">➕ Add</button>
                            </form>
                        </td>
                    </tr>
                </tbody>
            </table>
        }

        else
        {
            <p>No inventory items yet.</p>
        }

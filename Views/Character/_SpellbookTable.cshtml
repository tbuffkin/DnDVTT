@model Character

@if (Model.Spells != null)
{
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Level</th>
                <th style="width: 80px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var spell in Model.Spells)
            {
                <tr>
                    <td>
                        <input class="form-control" name="Name" value="@spell.Name" form="editSpell-@spell.Id" />
                    </td>
                    <td>
                        <input class="form-control" name="Description" value="@spell.Description" form="editSpell-@spell.Id" />
                    </td>
                    <td>
                        <input class="form-control" name="Level" type="number" value="@spell.Level" form="editSpell-@spell.Id" />
                    </td>
                    <td class="d-flex gap-1">
                        <form id="editSpell-@spell.Id" asp-controller="Spells" asp-action="Edit" method="post" class="d-flex gap-1">
                            <input type="hidden" name="Id" value="@spell.Id" />
                            <input type="hidden" name="CharacterID" value="@Model.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">💾</button>
                        </form>
                        <form asp-controller="Spells" asp-action="Remove" method="post">
                            <input type="hidden" name="id" value="@spell.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                        </form>
                    </td>
                </tr>
            }

            <!-- Inline Add New Spell Row -->
            <tr>
                <td colspan="4">
                    <form asp-controller="Spells" asp-action="Add" method="post" class="d-flex gap-2 align-items-center">
                        <input type="hidden" name="characterId" value="@Model.Id" />
                        <input class="form-control" name="name" placeholder="Spell name" />
                        <input class="form-control" name="description" placeholder="Description" />
                        <input class="form-control" name="level" type="number" value="1" style="width: 160px;" />
                        <button type="submit" class="btn btn-sm btn-success">➕ Add</button>
                    </form>
                </td>
            </tr>
        </tbody>
    </table>
}

